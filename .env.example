# Local development only. Copy to .env and set two different random passwords.
# .env is ignored by Git. Never commit real credentials.

POSTGRES_DB=ticketrush
POSTGRES_USER=ticketrush
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

REDIS_PASSWORD=
REDIS_PORT=6379

# Generated by pnpm --filter @ticketrush/api setup:local; never copy real values here.
DATABASE_URL=
DATABASE_ADMIN_URL=
JWT_SECRET=
PAYMENT_SECRET=
WEB_ORIGIN=http://127.0.0.1:3001
