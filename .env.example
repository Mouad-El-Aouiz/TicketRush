# Local development only. Copy to .env and set two different random passwords.
# .env is ignored by Git. Never commit real credentials.

POSTGRES_DB=ticketrush
POSTGRES_USER=ticketrush
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

REDIS_PASSWORD=
REDIS_PORT=6379
RABBITMQ_USER=ticketrush
RABBITMQ_PASSWORD=
NOTIFICATIONS_BROKER_URL=
NOTIFICATIONS_URL=
NOTIFICATIONS_SERVICE_KEY=
WEBHOOK_ENCRYPTION_KEY=

# Generated by pnpm --filter @ticketrush/api setup:local; never copy real values here.
DATABASE_URL=
DATABASE_ADMIN_URL=
JWT_SECRET=
PAYMENT_SECRET=
WEB_ORIGIN=http://127.0.0.1:3001

# Optional: configure both credentials in Google Cloud to enable local OAuth.
# The redirect URI must exactly match the URI registered in the Google OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Optional local RAG assistant; models are pulled manually into Ollama.
# For native Ollama use http://127.0.0.1:11434; Docker uses compose.ai.yaml.
OLLAMA_BASE_URL=
OLLAMA_CHAT_MODEL=qwen3:4b
OLLAMA_EMBEDDING_MODEL=embeddinggemma
