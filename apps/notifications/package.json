    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/node": "^26.0.0",
    "eslint": "10.13.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
